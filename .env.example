# Copy this file to .env and fill in what you need. Everything is optional for a demo.

# --- Razorpay (payments). Leave empty to use DEMO mode (test page, no real money).
# Get test keys: https://dashboard.razorpay.com -> Settings -> API Keys (Test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set in Razorpay Dashboard -> Webhooks (events: payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=
# auto = demo mode when keys are missing; 1 = force demo; 0 = force Razorpay
PAYMENT_DEMO_MODE=auto
PAYMENT_SERVER_PORT=5055

# --- Optional cloud vision for brand/model recognition (Anthropic API)
ANTHROPIC_API_KEY=
# PUNARTH_VISION_MODEL=claude-sonnet-5-5

# --- Camera index if you have more than one webcam
PUNARTH_CAMERA_INDEX=0
